# macOS
.DS_Store

# Python bytecode (Test-ControllerProfiles.py)
__pycache__/
*.pyc

# Build output in the WORKING trees only.
#
# Deliberately anchored rather than a bare `dist/`: some frozen snapshots under
# releases/ do contain a compiled EXE, and those are part of the historical
# record. A bare pattern would silently drop them.
/SteamShell/dist/
/SteamShell/build/
/current/
/current.staging-*/
/current.backup-*/

# 2.0.0 SHIPS ITS BINARY, so nothing under releases/2.0.0/current is ignored.
#
# That is a deliberate break from 1.9.9. This release stores the verified
# installer alongside the source that produced it, and its RELEASE.md checksums
# the executable, so excluding it would make the checksum table describe a file
# the repository does not contain. Build output under releases/2.0.0/SteamShell
# is still transient and is ignored below.
/releases/2.0.0/SteamShell/dist/
/releases/2.0.0/SteamShell/build/
/releases/2.0.0/current.staging-*/
/releases/2.0.0/current.backup-*/

# 2.0.1 ships its binary on the same terms, and these are listed BEFORE the
# release exists so the first lock cannot accidentally commit its own build
# output. Everything under releases/2.0.1/current stays tracked.
/releases/2.0.1/SteamShell/dist/
/releases/2.0.1/SteamShell/build/
/releases/2.0.1/current.staging-*/
/releases/2.0.1/current.backup-*/

# 2.0.2, listed before that release exists for the same reason 2.0.1's were.
# The lock is a Windows step -- it is a copy of this tree plus the verified
# installer, which only a Windows build produces -- so these entries are here
# waiting rather than describing something on disk.
/releases/2.0.2/SteamShell/dist/
/releases/2.0.2/SteamShell/build/
/releases/2.0.2/current.staging-*/
/releases/2.0.2/current.backup-*/

# Generated only when the self-contained 1.9.9 release bundle is rebuilt. That
# bundle predates the single-folder layout and still has a SteamShell-XFE tree
# of its own, so its paths are listed as they actually are.
/releases/1.9.9/SteamShell/dist/
/releases/1.9.9/SteamShell/build/
/releases/1.9.9/SteamShell-XFE/dist/
/releases/1.9.9/current/
/releases/1.9.9/current.staging-*/
/releases/1.9.9/current.backup-*/

# Runtime state. These are created beside the executable at run time and are
# machine-specific; the tracked files are the *_SAMPLE.ini templates.
*.log
*.log.[0-9]
*.log.[0-9][0-9]*
SteamShellSettings.ini
SteamShell-XFE.ini
SteamShell-XFE-Controllers.ini
setup-admin-requested.tmp
*.bak

# Local tool settings, not project configuration
.claude/settings.local.json

# Captured harness output. logs.txt was a tracked run transcript at the repo
# root, referenced by nothing, containing a LAN path and a machine account name.
# Removing it does not purge it from history -- it is low-risk enough not to be
# worth a rewrite -- but nothing new should land here.
logs.txt
wiki/
